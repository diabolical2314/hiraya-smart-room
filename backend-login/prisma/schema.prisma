// prisma/schema.prisma

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  // Remove the env() wrapper entirely
  url = "postgresql://postgres:mysecretpassword@localhost:5434/smartroom?schema=public"
}

model User {
  id       Int      @id @default(autoincrement())
  email    String   @unique
  password String
}

model SensorData {
  id          Int      @id @default(autoincrement())
  temperature Float
  humidity    Float
  power       Float?   // Optional power reading
  createdAt   DateTime @default(now()) 
}