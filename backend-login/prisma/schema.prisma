// prisma/schema.prisma

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = "postgresql://admin:adminpassword@localhost:5435/smartroom?schema=public"
}

model User {
  id       Int      @id @default(autoincrement())
  email    String   @unique
  password String
}

model SensorData {
  id          Int      @id @default(autoincrement())
  temperature Float
  humidity    Float
  current     Float?   // Optional power reading
  voltage     Float?   // Optional voltage reading
  createdAt   DateTime @default(now()) 
  
  roomId      String?      
  room        Room?    @relation(fields: [roomId], references: [id], onDelete: Cascade)
}

model Room {
  id            String       @id
  name          String       @unique
  description   String?      // Optional details
  sensors       SensorData[] 
  
  // ── NEW THRESHOLD FIELDS ADDED HERE ──
  tempThreshold Float        @default(28.0)
  humThreshold  Float        @default(70.0)
  pwrThreshold  Float        @default(500.0)

  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt
}